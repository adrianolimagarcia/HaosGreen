/target
config.toml

# Dashboard credentials (Argon2 password hash + bearer token hash). Lives in
# the home directory, which `general.home = "."` resolves to the working
# directory — so it would otherwise be one `git add -A` away from being
# committed.
web-auth.toml

*.swp
*.swo
.env
# The live database. `rustfox.db*` is the pre-rename name and is kept on
# purpose: an ignore rule is a safety net, not branding, and a stale database
# left in the tree holds memory contents that must never be committed.
haos-green.db*
rustfox.db*
.worktrees/

# Local benchmark artifacts. CLAUDE.md lists these under "Files Not to Commit",
# but nothing enforced it — they showed up as untracked on every `git status`.
.measure/

# Playwright config and cache
.playwright/

# Opencode
.opencode/package-lock.json
